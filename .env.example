# Environment variables for wpab-worker
# Copy this to .env and fill in your values

# Provider API keys (worker uses its own)
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# DEEPGRAM_API_KEY=...

# Required for production
# WPAB_ALLOWED_SITES=site1=secret1,site2=secret2

# Optional overrides
# WPAB_LOG_LEVEL=INFO
# WPAB_WORKER_ENV=development
# REDIS_URL=redis://localhost:6379
# WPAB_DEFAULT_MODEL=gpt-4o-mini-transcribe
# WPAB_MAX_DOWNLOAD_MB=200
# WPAB_DEFAULT_CHUNK_SECONDS=720
# WPAB_REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300
# WPAB_WORK_ROOT=/work
